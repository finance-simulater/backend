MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=finance
MYSQL_USER=finance_user
MYSQL_PASSWORD=change-me-database-password

DATABASE_URL=mysql+pymysql://finance_user:change-me-database-password@localhost:3306/finance

# Repository 통합 테스트(tests/integration)는 기본적으로 위 MYSQL_USER/MYSQL_PASSWORD/
# MYSQL_PORT/MYSQL_DATABASE로 자동 조합한 URL을 사용한다(테스트마다 트랜잭션을
# 롤백하므로 안전 — 별도 DB/GRANT 불필요). 다른 값을 쓰고 싶을 때만 아래를 지정한다.
# TEST_DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:<port>/<database>
REDIS_URL=redis://localhost:6379
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@fsimulation.store
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_TICKET_TTL_MINUTES=30
EMAIL_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
